# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Neon PostgreSQL connection string
# Get it from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Set to "neon" to use the Neon DB backend.
# Set to "static" (or leave unset) to fall back to the local JSON file.
VITE_DATA_SOURCE=neon
