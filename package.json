{
  "name": "rapistneta",
  "version": "1.0.0",
  "description": "Political accountability tracker for Indian politicians",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "dev:full": "concurrently -n \"api,web\" -c \"blue,green\" \"tsx server/index.ts\" \"vite\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "link-images": "node link-images.js",
    "validate": "tsx src/validation/validateDataset.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.api.json --noEmit",
    "generate-15k": "tsx scripts/generate-15k-dataset.ts",
    "db:seed": "tsx scripts/seed-neon.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vercel": "^65.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^5.0.8"
  }
}
